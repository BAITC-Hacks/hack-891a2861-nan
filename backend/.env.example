DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to postgres in Docker/production. SQLite is used by default for local setup.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=career_quest
POSTGRES_USER=career_quest
POSTGRES_PASSWORD=career_quest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional OpenAI-compatible provider. The recommendation engine must work without it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
